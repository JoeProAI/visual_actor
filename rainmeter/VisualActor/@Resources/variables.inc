[Variables]
; ---- Visual Actor widget variables (generated by build_rainmeter_skin.ps1) ----
ServerURL=http://127.0.0.1:8765/rainmeter
ServerHealthURL=http://127.0.0.1:8765/health

; Widget visual mode: "reactor" (arc-reactor visualizer) or "face" (avatar)
WidgetMode=reactor

; Geometry
Width=480
Height=640

; Appearance (0-255)
Opacity=255
Transparent=1

; Interaction toggles (0/1)
ClickThrough=0
AlwaysOnTop=1
Draggable=1

; Refresh cadence
RefreshMs=1000
StatusPollMs=3000

; PowerShell helpers
ServerStart=#@#launch_server.ps1
ServerStop=#@#stop_server.ps1
ServerCheck=#@#check_server.ps1
