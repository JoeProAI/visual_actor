# Visual Actor environment configuration.
# Copy to `.env` and fill in. All values have safe defaults except the
# ElevenLabs API key (without it, the router falls back to local engines).

# --- Conversation brain (OpenRouter) ---
# Required for the back-and-forth chat panel; get a key at
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# VISUAL_ACTOR_PERSONA=You are Aria, ...

# --- 3D avatar generation (one-time) ---
# https://platform.tripo3d.ai/api-keys — used by scripts/generate_avatar_tripo.py
TRIPO3D_API_KEY=

# --- Voice input (Whisper STT) ---
# WHISPER_MODEL=base.en

# --- ElevenLabs (primary voice engine) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Flash low-latency model (current generation as of build).
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Local backup voice engines ---
PIPER_MODEL_PATH=app/assets/models/piper/en_US-amy-low.onnx
FISH_SPEECH_MODEL_PATH=app/assets/models/fish-speech-s2

# --- Server ---
VISUAL_ACTOR_HOST=127.0.0.1
VISUAL_ACTOR_PORT=8765

# --- Rainmeter widget ---
RAINMETER_SERVER_URL=http://127.0.0.1:8765/rainmeter
RAINMETER_WIDTH=480
RAINMETER_HEIGHT=640
RAINMETER_OPACITY=255
RAINMETER_CLICK_THROUGH=0
RAINMETER_ALWAYS_ON_TOP=1
